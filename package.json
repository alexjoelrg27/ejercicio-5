{
  "name": "ejercicio-5",
  "version": "1.0.0",
  "private": true,
  "description": "Lista de tareas - HTML5, HTML semantico, WCAG AA y responsive",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test:html": "html-validate \"*.html\" --config .htmlvalidate.json",
    "test:links": "node scripts/check-links.mjs",
    "test:links:online": "cross-env LINK_CHECK_ONLINE=1 node scripts/check-links.mjs",
    "test:a11y": "playwright test",
    "test": "npm run test:html && npm run test:links",
    "test:all": "npm run test && npm run test:a11y",
    "serve": "node scripts/serve.mjs 8080"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "cross-env": "^7.0.3",
    "html-validate": "^10.4.0"
  }
}